{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "services/reasoning/Dockerfile" },
  "deploy": {
    "startCommand": "uvicorn reasoning_svc.main:app --host 0.0.0.0 --port ${PORT:-8001}",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
