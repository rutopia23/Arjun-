# Vercel project env (names only; set real values in the Vercel dashboard, never commit them).
# SERVER-SIDE ONLY (api/*.ts functions; never prefixed VITE_, so they are not in the browser bundle):
CORE_API_URL=
CORE_API_KEY=
ARJUN_ACCESS_CODE=
# Browser bundle: nothing is needed. The page calls same-origin /core/* and api/core.ts adds the key after the
# access check. The LiveKit URL comes from POST /livekit/token (core-api LIVEKIT_URL), not from the bundle.
